# GovernCRM 本地环境变量模板
#
# 用法：cp .env.example .env 后按需修改。
#   * 本文件**只含占位符与开关默认值，不含任何真实口令**；
#   * 真实口令（数据库口令、演示账号口令）只存在于本地 `.env`（已被 .gitignore 排除）；
#   * 演示账号口令由 T0.4 种子脚本生成并写入本地 `.env`，**不入库、不写进文档**。

# ---------------------------------------------------------------------------
# 数据库（本地 PostgreSQL 16 + pgvector，docker-compose 服务名 db）
# ---------------------------------------------------------------------------
POSTGRES_USER=governcrm
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=governcrm
POSTGRES_PORT=5432

# 应用侧连接串（SQLAlchemy + psycopg3）
# 注意：口令与上面保持一致；正式部署走密钥管理，不落盘
DATABASE_URL=postgresql+psycopg://governcrm:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/governcrm

# ---------------------------------------------------------------------------
# 应用
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 出境开关（PRD C9 / 附录 K）
# 默认 **关闭**：境外模型端点默认不启用，符合"私有化部署默认关闭"口径
# ---------------------------------------------------------------------------
THIRD_PARTY_INFERENCE_ENABLED=false

# ---------------------------------------------------------------------------
# Provider 凭据占位（默认留空；MVP 走模拟适配器，不需要真实调用）
# ---------------------------------------------------------------------------
# MODEL_PROVIDER=mock
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
